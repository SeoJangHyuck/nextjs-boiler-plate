{
  "name": "nextjs-boiler-plate",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js 16 Boilerplate",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dev": "NEXT_PUBLIC_ENV=dev next build",
    "build:live": "NEXT_PUBLIC_ENV=live next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:assets": "node scripts/check-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm lint:assets && pnpm type-check && pnpm test:run",
    "prepare": "husky"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "boilerplate"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=12.23.0 <13"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "{public,src}/**/*": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-devtools": "^5.108.2",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@redux-devtools/extension": "^4.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
